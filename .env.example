# Copy to .env and adjust if needed. .env is gitignored — real credentials
# never go in git.

# Databricks workspace URL (used by `make land`, `make deploy-job`,
# `make run-job`). Workspace-specific; authenticate once with:
#   databricks auth login --host <this URL>
# The SQL warehouse id is NOT set here — it is a bundle variable with a
# default in databricks.yml, since a warehouse id identifies compute, not a
# credential, and doesn't need to be kept out of a public repo the way a
# workspace host does.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
